  "version": "2.0.0",
  "description": "100% client-side, browser-only utility kit to merge PDFs, compress images, and convert images to PDF with zero server uploads.",
  "type": "module",
  "author": "Akhil Binu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akhil-Binu/pdf-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Akhil-Binu/pdf-browser/issues"
  },
  "homepage": "https://github.com/Akhil-Binu/pdf-browser#readme",
  "keywords": [
    "pdf",
    "pdf-merger",
    "image-compression",
    "image-to-pdf",
    "client-side",
    "browser-only",
    "privacy-first",
    "react",
    "vite",
    "typescript",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
