{
  "name": "@akhil-binu/pdf-browser",
  "version": "4.0.1",
  "description": "100% client-side, browser-only utility suite with 37 tools for PDF manipulation, AcroForm filling, AES-256 file encryption vaults, steganography, digital signatures, image compression, QR generation, screen recording, audio processing, and regex debugging with zero server uploads.",
  "type": "module",
  "author": "Akhil Binu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akhil-Binu/pdf-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Akhil-Binu/pdf-browser/issues"
  },
  "homepage": "https://github.com/Akhil-Binu/pdf-browser#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.html",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "keywords": [
    "pdf",
    "pdf-merger",
    "image-compression",
    "image-to-pdf",
    "client-side",
    "browser-only",
    "privacy-first",
    "react",
    "vite",
    "typescript",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "browser-image-compression": "^2.0.2",
    "file-saver": "^2.0.5",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/file-saver": "^2.0.7",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
